# ============================================================
# NAÇÃO | QUEM CHEGOU? — Variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ============================================================

# ---------- Banco de dados ----------
DATABASE_URL="postgresql://nacao:nacao@localhost:5432/nacao_relationship?schema=public"

# ---------- Sessão / Autenticação ----------
# Segredo usado para assinar cookies de sessão (HMAC).
# Gere com: openssl rand -hex 32
SESSION_SECRET="troque-me-por-32-bytes-hex-aleatorios"
# Duração da sessão em horas
SESSION_TTL_HOURS="12"

# ---------- Integração Tecnofit ----------
# Provider de dados: "mock" (desenvolvimento, sem credenciais) ou "http" (API real)
TECNOFIT_PROVIDER="mock"

# URL base da API externa Tecnofit.
# NÃO VERIFICADO: confirme o host exato na documentação oficial
# (https://api-externa-tecnofit.readme.io) antes de usar em produção.
TECNOFIT_API_BASE_URL=""

# Credenciais fornecidas pelo painel Tecnofit (Configurações > Integrações > API).
# Nunca expor no frontend. Nunca logar.
# Chave pública (api_key) — prefixo pk_tf_
TECNOFIT_API_KEY=""
# Chave privada (api_secret) — prefixo sk_tf_
TECNOFIT_API_SECRET=""

# Esquema de autenticação.
# CONFIRMADO (painel Tecnofit): as chaves de acesso têm duas partes —
# api_key (pública) e api_secret (privada) — e as duas juntas são trocadas
# por um TOKEN DE ACESSO TEMPORÁRIO. Não é chave direta no header.
# Por isso o padrão é "token-exchange".
# Outras opções ("bearer" | "api-key-header" | "basic") existem porque o
# adapter é genérico, mas não descrevem a Tecnofit.
TECNOFIT_AUTH_SCHEME="token-exchange"

# NÃO VERIFICADO: o PATH do endpoint que faz essa troca ainda não foi
# identificado. Informe-o em paths.authToken (endpoint-map.ts) ou via
# TECNOFIT_ENDPOINT_MAP. Sem ele o cliente recusa a chamada.
# Nome do header quando TECNOFIT_AUTH_SCHEME="api-key-header"
TECNOFIT_AUTH_HEADER="X-Api-Key"

# Timeout (ms) e política de retry das chamadas HTTP
TECNOFIT_TIMEOUT_MS="10000"
TECNOFIT_MAX_RETRIES="3"

# Rate limit observado na documentação oficial:
# 100 req/min por endpoint/IP e 200 req/min global.
# O client aplica um teto local mais conservador.
TECNOFIT_RATE_LIMIT_PER_MINUTE="80"

# ---------- Ingestão de eventos de catraca ----------
# "webhook" | "polling" | "both"
ACCESS_INGEST_MODE="polling"

# Segredo compartilhado para validar assinatura HMAC do webhook Tecnofit.
# NÃO VERIFICADO: confirme se a Tecnofit assina o payload e qual header usa.
TECNOFIT_WEBHOOK_SECRET=""
TECNOFIT_WEBHOOK_SIGNATURE_HEADER="x-tecnofit-signature"

# Intervalo do poller em segundos (respeite o rate limit)
ACCESS_POLL_INTERVAL_SECONDS="20"
# Janela de sobreposição do cursor, em segundos, para não perder eventos
ACCESS_POLL_OVERLAP_SECONDS="60"

# ---------- Observabilidade ----------
# "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
