# ============================================================================
# NAÇÃO ATHX — LIVE LEADERBOARD
# Copie para .env.local e preencha. Nada aqui é secreto por padrão: as duas
# primeiras variáveis são públicas por design (anon key é protegida por RLS).
# ============================================================================

# ---------------------------------------------------------------------------
# MODO DEMO — roda a aplicação inteira SEM banco, com 20 duplas fictícias.
# Use para avaliar o produto antes de criar o projeto no Supabase.
#   true  -> dados fictícios em memória (nenhuma chamada ao Supabase)
#   false -> dados reais do Supabase (exige as variáveis abaixo)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# SUPABASE — obrigatórias quando NEXT_PUBLIC_DEMO_MODE=false
# Settings > API no painel do Supabase.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# ---------------------------------------------------------------------------
# SERVICE ROLE — NUNCA prefixe com NEXT_PUBLIC_. NUNCA envie para o browser.
# Usada apenas em scripts de manutenção no servidor. Opcional.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# URL pública do site — usada para gerar o QR Code em /qr.
# Em produção: https://athx.nacaoclub.com.br (ou o domínio da Vercel)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
