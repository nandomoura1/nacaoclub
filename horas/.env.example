# ============================================================
# NAÇÃO | GESTÃO DE HORAS — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ============================================================

# PostgreSQL (local: docker compose up -d · produção: Supabase)
DATABASE_URL="postgresql://nacao:nacao@localhost:5432/nacao_horas?schema=public"
# Conexão direta para as migrations. Local: igual à DATABASE_URL.
# Supabase: DATABASE_URL = Transaction pooler (6543, com ?pgbouncer=true&connection_limit=1)
#           DIRECT_URL   = Session pooler (5432). Ver docs/colocar-no-ar.md.
DIRECT_URL="postgresql://nacao:nacao@localhost:5432/nacao_horas?schema=public"

# Banco usado SÓ pelos testes de integração — é apagado a cada execução.
TEST_DATABASE_URL="postgresql://nacao:nacao@localhost:5432/nacao_horas_test?schema=public"

# Segredo do HMAC das sessões. Gere com: openssl rand -hex 32
SESSION_SECRET="troque-por-64-caracteres-hex-aleatorios"

# Duração da sessão, em horas.
SESSION_TTL_HOURS="12"

# Código do PRIMEIRO ACESSO (/primeiro-acesso): cria o 1º administrador.
# Só funciona enquanto não existe nenhum usuário. Gere com: openssl rand -hex 16
SETUP_TOKEN=""
