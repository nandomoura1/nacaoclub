// NAÇÃO | GESTÃO DE HORAS — modelo de dados.
// Documentação: docs/02-banco-de-dados.md
//
// Convenções: UUID, snake_case no banco, tempo em MINUTOS inteiros,
// vigências [valid_from, valid_to] com valid_to nulo = em aberto.
// O que o Prisma não expressa (triggers append-only, exclusion
// constraints) vive em SQL puro dentro das migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// App: no Supabase, o "Transaction pooler" (porta 6543).
  url       = env("DATABASE_URL")
  /// Migrations: no Supabase, o "Session pooler" (porta 5432). Local: igual à DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Configuração
// ─────────────────────────────────────────────────────────────

/// Linha única (id = 1). O dia de corte da competência mora aqui:
/// 26 → competência "Setembro" = 26/08 a 25/09.
model AppSettings {
  id                Int       @id @default(1)
  periodStartDay    Int       @default(26) @map("period_start_day")
  timezone          String    @default("America/Sao_Paulo")
  /// Mensagem geral aos professores das Aulas Coletivas (CrossFit, Futevôlei, Funcional…), no texto da grade.
  teacherGuidelines String?   @map("teacher_guidelines")
  /// Mensagem geral aos professores da Musculação (Nação Fit).
  gymGuidelines     String?   @map("gym_guidelines")
  /// Domingo e feriado valem o dobro a partir desta data (antes dela, nada muda). Vazio = sempre.
  doubleHoursFrom   DateTime? @map("double_hours_from") @db.Date
  /// Funcionamento geral da Nação (referência para os setores sem horário próprio): { "1": [[360, 1320]], …, "F": […] }.
  nacaoHours        Json      @default("{}") @map("nacao_hours")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────
// Identidade e acesso
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdById        String?   @map("created_by") @db.Uuid
  /// WhatsApp para os avisos automáticos (ex.: líder de setor). Professor usa o do cadastro.
  phone              String?

  /// Cadastros de professor desta pessoa (perfil Professor: extrato próprio e treinos Personal).
  /// Uma pessoa pode ter mais de um (ex.: um cadastro no CrossFit e outro na Nação Fit).
  teachers   UserTeacher[]
  sessions   Session[]
  roles      UserRole[]
  areaScopes UserAreaScope[]
  auditLogs  AuditLog[]

  @@map("users")
}

/// Vínculo usuário ↔ cadastro de professor. Um cadastro pertence a no máximo um usuário.
model UserTeacher {
  userId    String @map("user_id") @db.Uuid
  teacherId String @unique @map("teacher_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([userId, teacherId])
  @@map("user_teachers")
}

/// Sessão opaca: o cookie leva um token aleatório; o banco guarda só o HMAC.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Papéis são dados: o admin pode criar "Supervisor Kids" combinando permissões.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo fixo, sincronizado a partir de src/server/auth/permissions.ts.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Área de coordenação: Nação Fit, CrossFit, Aulas Coletivas, Futevôlei…
/// O escopo do coordenador é definido por área, não por pessoa.
model CoordinationArea {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique
  color             String    @default("#0169E9")
  sortOrder         Int       @default(0) @map("sort_order")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  /// Não usado: as mensagens gerais são por gênero (app_settings: Musculação × Aulas Coletivas).
  teacherGuidelines String?   @map("teacher_guidelines")

  userScopes UserAreaScope[]
  modalities Modality[]

  @@map("coordination_areas")
}

model UserAreaScope {
  userId         String  @map("user_id") @db.Uuid
  areaId         String  @map("area_id") @db.Uuid
  canViewFinance Boolean @default(false) @map("can_view_finance")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area CoordinationArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([areaId])
  @@map("user_area_scopes")
}

// ─────────────────────────────────────────────────────────────
// Auditoria — append-only (trigger no banco bloqueia UPDATE/DELETE)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @default(now())
  actorId    String?  @map("actor_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  /// Frase em português para a tela de histórico.
  summary    String

  /// Restrict: usuário com histórico não é apagado, é desativado.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// E2 · Cadastros parametrizáveis (nada de modalidade no código)
// ─────────────────────────────────────────────────────────────

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  code      String?  @unique
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  modalities Modality[]

  @@map("cost_centers")
}

model Modality {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  areaId               String   @map("area_id") @db.Uuid
  costCenterId         String?  @map("cost_center_id") @db.Uuid
  color                String   @default("#0169E9")
  /// Duração padrão ao criar aula: Mobilidade nasce com 30.
  defaultDurationMin   Int      @default(60) @map("default_duration_min")
  /// Gestão por exceção: só exige confirmação onde a Nação quiser.
  requiresConfirmation Boolean  @default(false) @map("requires_confirmation")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  area          CoordinationArea      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  costCenter    CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  teachers      TeacherModality[]
  primaryOf     Teacher[]             @relation("PrimaryModality")
  aliases       TeacherAlias[]
  slotVersions  ScheduleSlotVersion[]
  occurrences   ClassOccurrence[]
  manualEntries ManualEntry[]
  workoutWeeks  WorkoutWeek[]
  tvScreens     TvScreen[]
  dutySectors   DutySector[]

  @@index([areaId])
  @@map("modalities")
}

enum ActivityKind {
  AULA
  PLANTAO
  COORDENACAO
  REUNIAO
  CURSO
  EVENTO
  PERSONAL
}

/// Nem toda hora é aula: plantão, coordenação, reunião… Cada tipo diz se conta hora.
model ActivityType {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  kind        ActivityKind
  countsHours Boolean      @default(true) @map("counts_hours")
  active      Boolean      @default(true)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  slotVersions ScheduleSlotVersion[]
  occurrences  ClassOccurrence[]

  @@map("activity_types")
}

/// Sala, quadra, box: é como a grade atual é organizada.
model Space {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slotVersions ScheduleSlotVersion[]
  occurrences  ClassOccurrence[]

  @@map("spaces")
}

model CancellationReason {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @unique
  /// O professor recebe a hora mesmo com a aula cancelada? Padrão: não.
  countsTeacherHours Boolean  @default(false) @map("counts_teacher_hours")
  requiresNote       Boolean  @default(false) @map("requires_note")
  active             Boolean  @default(true)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  occurrences ClassOccurrence[]

  @@map("cancellation_reasons")
}

model Position {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teachers Teacher[]

  @@map("positions")
}

model ContractType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teachers Teacher[]

  @@map("contract_types")
}

enum HolidayScope {
  NACIONAL
  DISTRITAL
  FACULTATIVO
  NACAO
}

enum HolidayPolicy {
  CANCELAR_TODAS
  MANTER_TODAS
  DECIDIR_INDIVIDUALMENTE
}

model Holiday {
  id        String        @id @default(uuid()) @db.Uuid
  date      DateTime      @unique @db.Date
  name      String
  scope     HolidayScope
  policy    HolidayPolicy @default(DECIDIR_INDIVIDUALMENTE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  occurrences ClassOccurrence[]

  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────
// E2 · Professores
// ─────────────────────────────────────────────────────────────

model Teacher {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  /// Como aparece na grade e no card: "Rafa", "Ju".
  displayName       String?   @map("display_name")
  email             String?
  phone             String?
  admissionDate     DateTime? @map("admission_date") @db.Date
  terminationDate   DateTime? @map("termination_date") @db.Date
  active            Boolean   @default(true)
  primaryModalityId String?   @map("primary_modality_id") @db.Uuid
  positionId        String?   @map("position_id") @db.Uuid
  contractTypeId    String?   @map("contract_type_id") @db.Uuid
  level             String?
  notes             String?
  /// Orientações só deste professor, no texto da grade compartilhado.
  guidelines        String?
  /// Time: PROFESSOR (área fim, horista, grade de aulas) ou ESCALA (área meio, escala 5x2).
  team              String    @default("PROFESSOR")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdById       String?   @map("created_by") @db.Uuid

  primaryModality  Modality?            @relation("PrimaryModality", fields: [primaryModalityId], references: [id], onDelete: SetNull)
  position         Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  contractType     ContractType?        @relation(fields: [contractTypeId], references: [id], onDelete: SetNull)
  modalities       TeacherModality[]
  aliases          TeacherAlias[]
  slotAssignments  SlotVersionTeacher[]
  plannedIn        ClassAssignment[]    @relation("PlannedAssignments")
  executedIn       ClassAssignment[]    @relation("ExecutingAssignments")
  leaves           Leave[]              @relation("TeacherLeaves")
  covering         Leave[]              @relation("LeaveSubstitute")
  manualEntries    ManualEntry[]
  duties           DutyAssignment[]
  userLink         UserTeacher?
  personalWorkouts PersonalWorkout[]
  documents        TeacherDocument[]
  wsMembers        WsMember[]

  @@index([active, name])
  @@index([team, active])
  @@map("teachers")
}

/// Habilitação: alimenta a sugestão de substitutos.
model TeacherModality {
  teacherId  String @map("teacher_id") @db.Uuid
  modalityId String @map("modality_id") @db.Uuid

  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@id([teacherId, modalityId])
  @@index([modalityId])
  @@map("teacher_modalities")
}

/// Só para a importação: "Juliana (mobility)" → Juliana + Mobilidade.
model TeacherAlias {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  /// Normalizado: minúsculas, sem acento, espaços colapsados.
  alias      String   @unique
  modalityId String?  @map("modality_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  modality Modality? @relation(fields: [modalityId], references: [id], onDelete: SetNull)

  @@map("teacher_aliases")
}

// ─────────────────────────────────────────────────────────────
// E3 · Grade padrão (CAMADA 1) — recorrente, com vigência
// ─────────────────────────────────────────────────────────────

/// Identidade estável de "a aula de segunda 05:00 de HYROX". Nunca muda.
model ScheduleSlot {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  versions         ScheduleSlotVersion[]
  leaves           Leave[]
  personalWorkouts PersonalWorkout[]

  @@map("schedule_slots")
}

/// O que a aula é, a partir de quando. "Alterar a partir de 15/10" fecha
/// esta versão em 14/10 e abre outra — o passado continua apontando para cá.
model ScheduleSlotVersion {
  id             String    @id @default(uuid()) @db.Uuid
  slotId         String    @map("slot_id") @db.Uuid
  /// 1 = segunda … 7 = domingo
  weekday        Int
  /// Minutos desde a meia-noite, horário de Brasília (05:30 = 330).
  startMin       Int       @map("start_min")
  durationMin    Int       @map("duration_min")
  modalityId     String    @map("modality_id") @db.Uuid
  activityTypeId String    @map("activity_type_id") @db.Uuid
  spaceId        String?   @map("space_id") @db.Uuid
  /// Turma: "Série A", "Master", "Aprendiz".
  label          String?
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  changeReason   String?   @map("change_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdById    String?   @map("created_by") @db.Uuid

  slot         ScheduleSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  modality     Modality             @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  activityType ActivityType         @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  space        Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  teachers     SlotVersionTeacher[]
  occurrences  ClassOccurrence[]

  @@index([slotId, validFrom])
  @@index([weekday, validFrom, validTo])
  @@index([modalityId])
  @@map("schedule_slot_versions")
}

enum AssignmentRole {
  TITULAR
  AUXILIAR
  ESTAGIARIO
}

/// Quem está escalado. Cada pessoa recebe a duração cheia da aula.
model SlotVersionTeacher {
  versionId String         @map("version_id") @db.Uuid
  teacherId String         @map("teacher_id") @db.Uuid
  role      AssignmentRole @default(TITULAR)

  version ScheduleSlotVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  teacher Teacher             @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([versionId, teacherId])
  @@index([teacherId])
  @@map("slot_version_teachers")
}

// ─────────────────────────────────────────────────────────────
// E4 · Competência (26 → 25), ocorrências e exceções (CAMADAS 2 e 3)
// ─────────────────────────────────────────────────────────────

enum PeriodStatus {
  ABERTO
  EM_REVISAO_COORDENACAO
  APROVADO_COORDENACAO
  REVISAO_ADMINISTRATIVA
  FECHADO
}

/// "Setembro/2026" = 26/08/2026 a 25/09/2026 (dia de corte em app_settings).
model PayrollPeriod {
  id            String       @id @default(uuid()) @db.Uuid
  year          Int
  month         Int
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date
  status        PeriodStatus @default(ABERTO)
  generatedAt   DateTime?    @map("generated_at")
  generatedById String?      @map("generated_by") @db.Uuid
  needsReview   Boolean      @default(false) @map("needs_review")
  closedAt      DateTime?    @map("closed_at")
  closedById    String?      @map("closed_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  occurrences   ClassOccurrence[]
  manualEntries ManualEntry[]

  @@unique([year, month])
  @@map("payroll_periods")
}

enum OccurrenceOrigin {
  GRADE
  EXTRA
}

enum OccurrenceStatus {
  PREVISTA
  REALIZADA
  CANCELADA
  AGUARDANDO_DECISAO_FERIADO
}

/// Uma aula numa data. Gerada da grade (idempotente) ou lançada avulsa.
model ClassOccurrence {
  id                   String           @id @default(uuid()) @db.Uuid
  periodId             String           @map("period_id") @db.Uuid
  date                 DateTime         @db.Date
  origin               OccurrenceOrigin @default(GRADE)
  slotId               String?          @map("slot_id") @db.Uuid
  slotVersionId        String?          @map("slot_version_id") @db.Uuid
  modalityId           String           @map("modality_id") @db.Uuid
  activityTypeId       String           @map("activity_type_id") @db.Uuid
  spaceId              String?          @map("space_id") @db.Uuid
  label                String?
  startMin             Int              @map("start_min")
  durationMin          Int              @map("duration_min")
  /// O que a grade dizia — congelado. Os campos acima refletem as exceções.
  plannedStartMin      Int              @map("planned_start_min")
  plannedDurationMin   Int              @map("planned_duration_min")
  status               OccurrenceStatus @default(PREVISTA)
  holidayId            String?          @map("holiday_id") @db.Uuid
  cancellationReasonId String?          @map("cancellation_reason_id") @db.Uuid
  /// Alguém registrou algo nesta aula: a regeneração da grade não toca mais nela.
  touched              Boolean          @default(false)
  /// A grade mudou depois de alguém mexer nesta aula: um humano precisa olhar.
  needsReview          Boolean          @default(false) @map("needs_review")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  period             PayrollPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  slotVersion        ScheduleSlotVersion? @relation(fields: [slotVersionId], references: [id], onDelete: Restrict)
  modality           Modality             @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  activityType       ActivityType         @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  space              Space?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  holiday            Holiday?             @relation(fields: [holidayId], references: [id], onDelete: SetNull)
  cancellationReason CancellationReason?  @relation(fields: [cancellationReasonId], references: [id], onDelete: Restrict)
  assignments        ClassAssignment[]
  exceptions         ClassException[]
  /// Aula nascida de uma escala de fim de semana/feriado (horas de plantão).
  dutyShiftId        String?              @map("duty_shift_id") @db.Uuid
  dutyShift          DutyShift?           @relation(fields: [dutyShiftId], references: [id], onDelete: Cascade)

  @@unique([slotId, date])
  @@index([periodId, date])
  @@index([date, startMin])
  @@index([modalityId, date])
  @@map("class_occurrences")
}

enum AssignmentStatus {
  PREVISTA
  REALIZADA
  SUBSTITUIDA
  CANCELADA
  AUSENTE_PENDENTE
}

enum AbsenceReason {
  FALTA
  FERIAS
  ATESTADO
  FOLGA
  OUTRO
}

/// Uma "cadeira de professor" na aula. É o que gera hora.
model ClassAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  occurrenceId       String           @map("occurrence_id") @db.Uuid
  role               AssignmentRole   @default(TITULAR)
  /// Quem a grade escalou. Nulo = aula avulsa (não havia previsão).
  plannedTeacherId   String?          @map("planned_teacher_id") @db.Uuid
  /// Quem deu a aula. Nulo = ninguém (cancelada ou aguardando substituto).
  executingTeacherId String?          @map("executing_teacher_id") @db.Uuid
  minutes            Int
  status             AssignmentStatus @default(PREVISTA)
  absenceReason      AbsenceReason?   @map("absence_reason")
  /// Ausência abonada: o tempo previsto conta para o professor mesmo sem dar a aula.
  absencePaid        Boolean          @default(false) @map("absence_paid")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  occurrence       ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  plannedTeacher   Teacher?        @relation("PlannedAssignments", fields: [plannedTeacherId], references: [id], onDelete: Restrict)
  executingTeacher Teacher?        @relation("ExecutingAssignments", fields: [executingTeacherId], references: [id], onDelete: Restrict)

  @@index([occurrenceId])
  @@index([plannedTeacherId])
  @@index([executingTeacherId])
  @@map("class_assignments")
}

enum ExceptionType {
  FALTA
  FERIAS
  ATESTADO
  FOLGA
  SUBSTITUICAO
  AULA_CANCELADA
  AULA_EXTRA
  ALTERACAO_HORARIO
  CONFIRMACAO
  COMPENSACAO
  DECISAO_FERIADO
  REVERSAO
  OUTRO
}

/// Fato registrado sobre uma aula. Somente-inclusão: desfazer = nova exceção REVERSAO.
model ClassException {
  id                   String        @id @default(uuid()) @db.Uuid
  occurrenceId         String        @map("occurrence_id") @db.Uuid
  assignmentId         String?       @map("assignment_id") @db.Uuid
  type                 ExceptionType
  cancellationReasonId String?       @map("cancellation_reason_id") @db.Uuid
  notes                String?
  before               Json?
  after                Json?
  revertsExceptionId   String?       @map("reverts_exception_id") @db.Uuid
  leaveId              String?       @map("leave_id") @db.Uuid
  createdById          String?       @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  leave      Leave?          @relation(fields: [leaveId], references: [id], onDelete: Restrict)

  @@index([occurrenceId, createdAt])
  @@index([leaveId])
  @@map("class_exceptions")
}

// ─────────────────────────────────────────────────────────────
// E5 · Férias/afastamentos e lançamentos manuais
// ─────────────────────────────────────────────────────────────

enum LeaveType {
  FERIAS
  ATESTADO
  AFASTAMENTO
  FOLGA
  FALTA
  INDISPONIVEL
}

enum LeaveCoverage {
  PENDENTE
  CANCELAR
  SUBSTITUIR
}

/// Período de ausência. Vale para as aulas já geradas E para as geradas depois.
model Leave {
  id            String        @id @default(uuid()) @db.Uuid
  teacherId     String        @map("teacher_id") @db.Uuid
  type          LeaveType
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  coverage      LeaveCoverage @default(PENDENTE)
  substituteId  String?       @map("substitute_id") @db.Uuid
  /// Substituição só nesta aula da grade (vazio = todas as aulas do professor).
  slotId        String?       @map("slot_id") @db.Uuid
  /// Desconta das horas do professor? false = abonada (atestado/folga, em geral): as aulas seguem contando para ele.
  deductsHours  Boolean       @default(true) @map("deducts_hours")
  notes         String?
  createdById   String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  /// Ausência anulada (não se apaga: as aulas voltam ao previsto, com registro).
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelledById String?       @map("cancelled_by") @db.Uuid

  teacher    Teacher          @relation("TeacherLeaves", fields: [teacherId], references: [id], onDelete: Restrict)
  substitute Teacher?         @relation("LeaveSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)
  slot       ScheduleSlot?    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  exceptions ClassException[]

  @@index([teacherId, startDate, endDate])
  @@index([slotId])
  @@map("leaves")
}

enum ManualEntryType {
  COORDENACAO
  REUNIAO
  CURSO
  EVENTO
  COMPENSACAO
  AJUSTE
  OUTRO
}

/// Horas que não vêm da grade (coordenação, reunião, compensação). ± minutos.
model ManualEntry {
  id          String          @id @default(uuid()) @db.Uuid
  periodId    String          @map("period_id") @db.Uuid
  teacherId   String          @map("teacher_id") @db.Uuid
  modalityId  String?         @map("modality_id") @db.Uuid
  type        ManualEntryType
  minutes     Int
  date        DateTime?       @db.Date
  notes       String
  /// Lançamento anulado (não se apaga: anula-se, com motivo).
  voidedAt    DateTime?       @map("voided_at")
  voidedById  String?         @map("voided_by") @db.Uuid
  voidReason  String?         @map("void_reason")
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  teacher  Teacher       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  modality Modality?     @relation(fields: [modalityId], references: [id], onDelete: SetNull)

  @@index([periodId, teacherId])
  @@map("manual_entries")
}

// ─────────────────────────────────────────────────────────────
// Treinos da semana (módulo à parte: não mexe na grade nem nas horas)
// ─────────────────────────────────────────────────────────────

enum WorkoutBlockKind {
  MOBILIDADE
  AQUECIMENTO
  SKILL
  CORE
  FORCA
  ESPECIFICO
  WOD
  FUNDAMENTO
  JOGO
  OUTRO
}

enum BenchmarkCategory {
  GIRL
  HERO
  CLASSICO
  NACAO
}

/// Biblioteca de benchmarks (Girls, Heroes, clássicos e os da própria Nação).
/// source CROSSFIT = definição pública oficial (só ativa/desativa); NACAO = criado pela equipe.
model WorkoutBenchmark {
  id          String            @id @default(uuid()) @db.Uuid
  /// Modalidade dona do benchmark (slug: crossfit, funcional, hyrox, futevolei).
  modality    String            @default("crossfit")
  name        String
  category    BenchmarkCategory
  format      String?
  timeCapMin  Int?              @map("time_cap_min")
  /// Um movimento por linha.
  content     String
  /// Pesos Rx, adaptações, história.
  notes       String?
  source      String            @default("NACAO")
  active      Boolean           @default(true)
  createdById String?           @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([modality, name])
  @@map("workout_benchmarks")
}

/// Plano semanal de treinos de uma modalidade (a arte "Plano semanal de treinos").
model WorkoutWeek {
  id          String   @id @default(uuid()) @db.Uuid
  modalityId  String   @map("modality_id") @db.Uuid
  /// Segunda-feira da semana.
  weekStart   DateTime @map("week_start") @db.Date
  /// Intenção / ideia central da semana ("Levantada"): vai no texto do WhatsApp e no plano do professor.
  theme       String?
  /// Rodapé de anúncio (novidade da Nação). Vazio = rodapé padrão.
  footerTitle String?  @map("footer_title")
  footerText  String?  @map("footer_text")
  /// Destaques do rodapé: "Aulão CrossFit|7H" um por linha.
  footerChips String?  @map("footer_chips")
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  modality Modality     @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  days     WorkoutDay[]

  @@unique([modalityId, weekStart])
  @@map("workout_weeks")
}

/// Tela de TV do box: abre por um link secreto (sem login) e mostra sozinha o
/// treino do dia da modalidade — ou o dia fixado pelo coach.
model TvScreen {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  modalityId String    @map("modality_id") @db.Uuid
  /// Link secreto da TV (/tv/<token>). Trocar o token derruba o link antigo.
  token      String    @unique
  /// Dia fixado na tela; vale até passar. Vazio = sempre o treino de hoje.
  pinnedDate DateTime? @map("pinned_date") @db.Date
  active     Boolean   @default(true)
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  @@map("tv_screens")
}

model WorkoutDay {
  id     String   @id @default(uuid()) @db.Uuid
  weekId String   @map("week_id") @db.Uuid
  date   DateTime @db.Date
  /// Opcional: "Aulão", "Benchmark", "Treino em dupla".
  title  String?

  week   WorkoutWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  blocks WorkoutBlock[]

  @@unique([weekId, date])
  @@map("workout_days")
}

/// Um bloco do treino. Fases genéricas usam só tipo + duração; Força e WOD vêm detalhados.
model WorkoutBlock {
  id          String           @id @default(uuid()) @db.Uuid
  dayId       String           @map("day_id") @db.Uuid
  sortOrder   Int              @default(0) @map("sort_order")
  kind        WorkoutBlockKind
  /// Nome do WOD/benchmark ou do exercício principal: "O'Connor", "Snatch complex".
  title       String?
  durationMin Int?             @map("duration_min")
  /// "For time", "AMRAP", "EMOM", "Intervalado", "5x5"…
  format      String?
  timeCapMin  Int?             @map("time_cap_min")
  /// Um movimento/linha por linha. Base da biblioteca da metodologia Nação.
  content     String?
  notes       String?
  /// Orientações ao professor (cues, escalas, progressões). Só no plano de aula, nunca para os alunos.
  coachNotes  String?          @map("coach_notes")

  day WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, sortOrder])
  @@map("workout_blocks")
}

// ─────────────────────────────────────────────────────────────
// Escalas de fim de semana e feriados (geram horas de plantão)
// ─────────────────────────────────────────────────────────────

/// Setor escalado: Academia, CrossFit e HYROX, Brinquedoteca…
model DutySector {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  /// As horas da escala entram nesta modalidade (e na área dela).
  modalityId  String  @map("modality_id") @db.Uuid
  /// Turnos padrão: { "SAB": [[420, 1020]], "DOM": [[480, 840]], "FERIADO": [[480, 840]] } em minutos.
  defaults    Json    @default("{}")
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)
  /// false = escala só organizacional (ex.: Aulões, pagos pelos próprios alunos): não gera horas.
  countsHours Boolean @default(true) @map("counts_hours")

  modality Modality    @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  shifts   DutyShift[]

  @@map("duty_sectors")
}

model DutyShift {
  id          String   @id @default(uuid()) @db.Uuid
  sectorId    String   @map("sector_id") @db.Uuid
  date        DateTime @db.Date
  startMin    Int      @map("start_min")
  endMin      Int      @map("end_min")
  notes       String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sector      DutySector        @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  people      DutyAssignment[]
  occurrences ClassOccurrence[]

  @@index([date, sectorId])
  @@map("duty_shifts")
}

model DutyAssignment {
  shiftId   String  @map("shift_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  note      String?

  shift   DutyShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  teacher Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([shiftId, teacherId])
  @@map("duty_assignments")
}

/// Planilha gerada pela IA: estratégia (periodização ou continuidade) de N dias
/// e as aulas completas geradas dia a dia. Só vira treino oficial quando o
/// coach lança os dias no Cadastro de Treino.
model TrainingProgram {
  id          String   @id @default(uuid()) @db.Uuid
  /// Slug da modalidade (crossfit, funcional…).
  modality    String
  title       String
  /// "periodizacao" (objetivo com fases) ou "continuidade" (segue a programação recente).
  kind        String
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  /// Pedido do coach (objetivo, prazo, dias da semana, janela).
  request     Json
  /// Estratégia: fases, semanas e o tema de cada dia.
  plan        Json
  /// Aulas geradas: { "AAAA-MM-DD": { plan, check, generatedAt } }.
  days        Json     @default("{}")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([modality, createdAt])
  @@map("training_programs")
}

/// Treino de Personal: o professor monta o treino de UMA aula de Personal dele
/// (aula da grade + data), para o aluno. Não entra no Cadastro de Treino semanal.
model PersonalWorkout {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  /// Aula de Personal da grade (vazio = aula avulsa, fora da grade).
  slotId      String?  @map("slot_id") @db.Uuid
  date        DateTime @db.Date
  startMin    Int?     @map("start_min")
  student     String?
  title       String
  goal        String?
  /// Blocos no mesmo formato do Cadastro de Treino: [{ kind, title, durationMin, format, content, notes }].
  blocks      Json
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher Teacher       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  slot    ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([teacherId, date])
  @@map("personal_workouts")
}

// ─────────────────────────────────────────────────────────────
// Condomínio Nação: rateio mensal dos gastos comuns do espaço e
// cobrança dos parceiros (energia, condomínio, IPTU, itens)
// ─────────────────────────────────────────────────────────────

enum CondoCenterKind {
  INTERNAL
  PARTNER
}

enum CondoBilling {
  FULL
  PRORATA
  NONE
}

enum CondoPeriodStatus {
  DRAFT
  CLOSED
}

enum CondoExpenseKind {
  FIXED
  VARIABLE
}

enum CondoChargeStatus {
  PENDING
  SENT
  PAID
}

/// Dados de recebimento e padrões do Condomínio (linha única, id = 1).
model CondoSettings {
  id            Int      @id @default(1)
  payeeName     String   @default("Nação Club Recreações Esportivas Ltda") @map("payee_name")
  payeeDocument String   @default("17.179.101/0001-74") @map("payee_document")
  /// Chave PIX do recebedor: com ela o PDF leva o QR Code "copia e cola".
  pixKey        String?  @map("pix_key")
  /// Cidade do recebedor no payload PIX (sem acento, até 15 letras).
  pixCity       String   @default("BRASILIA") @map("pix_city")
  bankInfo      String?  @map("bank_info")
  /// Ex.: "Envie o comprovante para financeiro@…".
  instructions  String?
  dueDay        Int      @default(20) @map("due_day")
  /// Fator de cada bandeira tarifária: { "VERDE": 1.15, … }.
  flagFactors   Json     @map("flag_factors")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("condo_settings")
}

/// Centro de custo que ocupa o espaço: operação interna (só entra no rateio)
/// ou parceiro (recebe a cobrança mensal).
model CondoCenter {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique
  /// Nome no documento de cobrança ("Futebol Society"). Vazio = name.
  displayName  String?         @map("display_name")
  kind         CondoCenterKind
  /// Lanchonete: assume o percentual fixo do total (30%).
  isSnackBar   Boolean         @default(false) @map("is_snack_bar")
  /// Participa do rateio do condomínio.
  chargesCondo Boolean         @default(true) @map("charges_condo")
  areaM2       Decimal         @default(0) @map("area_m2") @db.Decimal(10, 2)
  /// Quanto da cota de IPTU o parceiro paga (Society: 50).
  iptuSharePct Decimal         @default(100) @map("iptu_share_pct") @db.Decimal(5, 2)
  legalName    String?         @map("legal_name")
  document     String?
  contactName  String?         @map("contact_name")
  contactPhone String?         @map("contact_phone")
  contactEmail String?         @map("contact_email")
  activeFrom   DateTime        @map("active_from") @db.Date
  activeTo     DateTime?       @map("active_to") @db.Date
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  meters  CondoMeter[]
  items   CondoRecurringItem[]
  periods CondoPeriodCenter[]
  charges CondoCharge[]

  @@map("condo_centers")
}

/// Submedidor de energia de um centro de custo.
model CondoMeter {
  id             String    @id @default(uuid()) @db.Uuid
  centerId       String    @map("center_id") @db.Uuid
  name           String
  /// Leitura no dia da instalação: o 1º mês cobra só o que passar dela.
  installReading Decimal   @default(0) @map("install_reading") @db.Decimal(12, 1)
  activeFrom     DateTime  @map("active_from") @db.Date
  activeTo       DateTime? @map("active_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  center   CondoCenter         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  readings CondoMeterReading[]

  @@map("condo_meters")
}

/// Leitura acumulada do relógio na competência ("AAAA-MM").
model CondoMeterReading {
  id        String   @id @default(uuid()) @db.Uuid
  meterId   String   @map("meter_id") @db.Uuid
  month     String   @db.Char(7)
  reading   Decimal  @db.Decimal(12, 1)
  estimated Boolean  @default(false)
  /// Troca/zeramento do relógio: última leitura do antigo e a inicial do novo.
  isReset   Boolean  @default(false) @map("is_reset")
  oldFinal  Decimal? @map("old_final") @db.Decimal(12, 1)
  baseline  Decimal? @db.Decimal(12, 1)
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  meter CondoMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@unique([meterId, month])
  @@map("condo_meter_readings")
}

/// IPTU do ano: valor total, área total e janela de parcelas (2026: 6x, maio a outubro).
model CondoIptuYear {
  year        Int     @id
  totalCents  Int     @map("total_cents")
  totalAreaM2 Decimal @map("total_area_m2") @db.Decimal(10, 2)
  firstMonth  Int     @map("first_month")
  parcels     Int

  @@map("condo_iptu_years")
}

/// Item fixo da cobrança de um parceiro (Aluguel da Sala, Check In Funcional 28 × R$ 25…).
model CondoRecurringItem {
  id          String    @id @default(uuid()) @db.Uuid
  centerId    String    @map("center_id") @db.Uuid
  description String
  /// Valor fixo (quando não é quantidade × unitário).
  amountCents Int       @default(0) @map("amount_cents")
  /// Quantidade × unitário: o unitário fica aqui; a quantidade vem do mês anterior.
  unitCents   Int?      @map("unit_cents")
  defaultQty  Decimal?  @map("default_qty") @db.Decimal(10, 2)
  activeFrom  DateTime  @map("active_from") @db.Date
  activeTo    DateTime? @map("active_to") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")

  center CondoCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@map("condo_recurring_items")
}

/// Competência do Condomínio (o mês vencido que está sendo cobrado).
model CondoPeriod {
  id          String            @id @default(uuid()) @db.Uuid
  month       String            @unique @db.Char(7)
  dueDate     DateTime          @map("due_date") @db.Date
  status      CondoPeriodStatus @default(DRAFT)
  tariff      Decimal           @db.Decimal(12, 7)
  flag        String            @default("VERDE")
  flagFactor  Decimal           @map("flag_factor") @db.Decimal(6, 4)
  snackBarPct Decimal           @default(30) @map("snack_bar_pct") @db.Decimal(5, 2)
  notes       String?
  /// Resultado congelado no fechamento (rateio, energia, cobranças): o PDF enviado nunca muda.
  snapshot    Json?
  /// Importada da planilha (cobranças como foram cobradas na época).
  imported    Boolean           @default(false)
  closedAt    DateTime?         @map("closed_at")
  closedById  String?           @map("closed_by") @db.Uuid
  createdById String?           @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  expenses CondoExpense[]
  centers  CondoPeriodCenter[]
  items    CondoPeriodItem[]
  charges  CondoCharge[]

  @@map("condo_periods")
}

/// Despesa comum do mês (Tabela 1).
model CondoExpense {
  id          String           @id @default(uuid()) @db.Uuid
  periodId    String           @map("period_id") @db.Uuid
  group       String
  description String
  amountCents Int              @map("amount_cents")
  kind        CondoExpenseKind @default(VARIABLE)
  /// Variável copiada do mês anterior: precisa ser confirmada antes do fechamento.
  confirmed   Boolean          @default(true)
  /// Memória de cálculo: "1.730 + 1.000 + 1.986 + 993,47".
  memo        String?
  sortOrder   Int              @default(0) @map("sort_order")

  period CondoPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, sortOrder])
  @@map("condo_expenses")
}

/// Centro de custo na competência: nº de alunos/colaboradores e como cobrar (entrada/saída no meio do mês).
model CondoPeriodCenter {
  periodId  String       @map("period_id") @db.Uuid
  centerId  String       @map("center_id") @db.Uuid
  headcount Int          @default(0)
  billing   CondoBilling @default(FULL)

  period CondoPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  center CondoCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([periodId, centerId])
  @@map("condo_period_centers")
}

/// Item da cobrança de um parceiro no mês: fixo (copiado do cadastro) ou avulso.
model CondoPeriodItem {
  id              String   @id @default(uuid()) @db.Uuid
  periodId        String   @map("period_id") @db.Uuid
  centerId        String   @map("center_id") @db.Uuid
  recurringItemId String?  @map("recurring_item_id") @db.Uuid
  description     String
  qty             Decimal? @db.Decimal(10, 2)
  unitCents       Int?     @map("unit_cents")
  amountCents     Int      @default(0) @map("amount_cents")
  adhoc           Boolean  @default(false)
  sortOrder       Int      @default(0) @map("sort_order")

  period CondoPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, centerId])
  @@map("condo_period_items")
}

/// Cobrança de um parceiro na competência fechada (snapshot das linhas).
model CondoCharge {
  id          String            @id @default(uuid()) @db.Uuid
  periodId    String            @map("period_id") @db.Uuid
  centerId    String            @map("center_id") @db.Uuid
  /// Nº do documento (sequencial, mantido ao refechar).
  number      Int               @default(autoincrement())
  centerName  String            @map("center_name")
  totalCents  Int               @map("total_cents")
  /// [{ kind, description, cents, detail }]
  lines       Json
  dueDate     DateTime          @map("due_date") @db.Date
  status      CondoChargeStatus @default(PENDING)
  sentAt      DateTime?         @map("sent_at")
  paidAt      DateTime?         @map("paid_at") @db.Date
  paidCents   Int?              @map("paid_cents")
  paymentNote String?           @map("payment_note")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  period CondoPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  center CondoCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([periodId, centerId])
  @@map("condo_charges")
}

// ─────────────────────────────────────────────────────────────
// Financeiro · Relatório Financeiro: base histórica mensal
// (documentos → extração → conferência → versão aprovada → indicadores)
// ─────────────────────────────────────────────────────────────

enum FinPeriodStatus {
  DRAFT
  REVIEW
  APPROVED
}

enum FinDocStatus {
  PROCESSING
  EXTRACTED
  PENDING_REVIEW
  APPROVED
  DIVERGENT
  ERROR
}

enum FinDocOrigin {
  UPLOAD
  HISTORICO
}

enum FinLineStatus {
  EXTRACTED
  CONFIRMED
  EDITED
  MANUAL
}

enum FinDataset {
  RECEITA
  DESPESA
  MODALIDADE
  ALUNOS
  PDV_RESUMO
  PDV_PAGAMENTO
  PDV_PRODUTO
  CAIXA
  INVESTIMENTO
  FINANCIAMENTO
  INDICADOR
  ESTOQUE
}

/// Competência do Relatório Financeiro (AAAA-MM).
model FinPeriod {
  id               String          @id @default(uuid()) @db.Uuid
  month            String          @unique @db.Char(7)
  status           FinPeriodStatus @default(DRAFT)
  /// Nº da última versão aprovada (0 = nunca aprovada).
  version          Int             @default(0)
  /// Observações do gestor (contexto, não é dado financeiro).
  managerNotes     String?         @map("manager_notes")
  /// Decisões dos sócios (não são lançamentos).
  partnerDecisions String?         @map("partner_decisions")
  /// Contexto dos sócios para o relatório (a IA considera; não é dado financeiro).
  partnerContext   String?         @map("partner_context")
  /// Itens desconsiderados neste relatório: [{ key, reason }].
  reportExclusions Json?           @map("report_exclusions")
  /// Quando o contexto/ajustes mudaram (para avisar que a análise ficou desatualizada).
  contextAt        DateTime?       @map("context_at")
  /// Ajustes estruturais que a IA fez a partir do contexto dos sócios (ContextPlan).
  contextPlan      Json?           @map("context_plan")
  /// Análise escrita pela IA a partir dos indicadores calculados.
  analysis         Json?
  analysisAt       DateTime?       @map("analysis_at")
  approvedAt       DateTime?       @map("approved_at")
  approvedById     String?         @map("approved_by") @db.Uuid
  createdById      String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  documents       FinDocument[]
  lines           FinLine[]
  versions        FinVersion[]
  reconciliations FinReconciliation[]

  @@map("fin_periods")
}

/// Documento enviado (metadados; os bytes ficam em fin_document_files).
model FinDocument {
  id            String       @id @default(uuid()) @db.Uuid
  periodId      String?      @map("period_id") @db.Uuid
  kind          String
  filename      String
  mimeType      String       @map("mime_type")
  sizeBytes     Int          @map("size_bytes")
  sha256        String       @db.Char(64)
  status        FinDocStatus @default(PROCESSING)
  origin        FinDocOrigin @default(UPLOAD)
  /// N-ésimo documento deste tipo na competência.
  version       Int          @default(1)
  notes         String?
  error         String?
  /// Saída bruta da extração (auditoria do que a IA leu).
  extraction    Json?
  detectedMonth String?      @map("detected_month") @db.Char(7)
  uploadedById  String?      @map("uploaded_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  period FinPeriod?       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  file   FinDocumentFile?
  lines  FinLine[]

  @@index([periodId, kind])
  @@map("fin_documents")
}

model FinDocumentFile {
  documentId String @id @map("document_id") @db.Uuid
  data       Bytes

  document FinDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("fin_document_files")
}

/// Taxonomia (configurável): receitas e despesas com a classificação e as regras.
model FinCategory {
  key              String  @id
  label            String
  kind             String
  classification   String
  /// Entra no custo econômico de pessoal.
  personnel        Boolean @default(false)
  /// Receita operacional (aporte/empréstimo não é).
  operatingRevenue Boolean @default(true) @map("operating_revenue")
  sortOrder        Int     @default(0) @map("sort_order")
  active           Boolean @default(true)

  @@map("fin_categories")
}

/// Um dado financeiro da competência, com origem e conferência.
model FinLine {
  id             String        @id @default(uuid()) @db.Uuid
  periodId       String        @map("period_id") @db.Uuid
  dataset        FinDataset
  /// Categoria (receita/despesa), chave do PDV, forma de pagamento, grupo, indicador…
  key            String?
  label          String
  /// Modalidade, conta bancária ou grupo de produto.
  unit           String?
  amountCents    Int?          @map("amount_cents")
  quantity       Decimal?      @db.Decimal(14, 2)
  classification String?
  meta           Json?
  documentId     String?       @map("document_id") @db.Uuid
  /// Página/linha/célula onde o dado está.
  sourceRef      String?       @map("source_ref")
  /// Texto/valor como estava no documento.
  sourceValue    String?       @map("source_value")
  /// Regra usada na classificação.
  rule           String?
  status         FinLineStatus @default(EXTRACTED)
  confirmedById  String?       @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime?     @map("confirmed_at")
  createdById    String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  period   FinPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  document FinDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([periodId, dataset])
  @@map("fin_lines")
}

/// Versão aprovada: o retrato congelado (linhas, indicadores, documentos, notas).
model FinVersion {
  id          String   @id @default(uuid()) @db.Uuid
  periodId    String   @map("period_id") @db.Uuid
  number      Int
  reason      String?
  snapshot    Json
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  period FinPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, number])
  @@map("fin_versions")
}

/// Justificativa de uma conciliação (ex.: PDV × receita de vendas).
model FinReconciliation {
  periodId      String   @map("period_id") @db.Uuid
  key           String
  justification String
  updatedById   String?  @map("updated_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at")

  period FinPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@id([periodId, key])
  @@map("fin_reconciliations")
}

/// Metas e limites do Relatório Financeiro (linha única, id = 1).
model FinSettings {
  id        Int      @id @default(1)
  targets   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fin_settings")
}

// ─────────────────────────────────────────────────────────────
// Documentos da equipe (identidade, CREF, contratos) e contador do estágio
// ─────────────────────────────────────────────────────────────

enum StaffDocKind {
  IDENTIDADE
  CREF
  CONTRATO_TRABALHO
  CONTRATO_ESTAGIO
  ATESTADO
  OUTRO
}

model TeacherDocument {
  id           String       @id @default(uuid()) @db.Uuid
  teacherId    String       @map("teacher_id") @db.Uuid
  kind         StaffDocKind
  filename     String
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  sha256       String       @db.Char(64)
  /// Contrato: início; CREF: emissão (opcional).
  validFrom    DateTime?    @map("valid_from") @db.Date
  /// Contrato: fim (obrigatório no estágio); CREF: validade.
  validUntil   DateTime?    @map("valid_until") @db.Date
  /// Nº do RG/CNH ou do registro no CREF.
  number       String?
  notes        String?
  uploadedById String?      @map("uploaded_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  teacher Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  file    TeacherDocumentFile?

  @@index([teacherId, kind])
  @@map("teacher_documents")
}

model TeacherDocumentFile {
  documentId String @id @map("document_id") @db.Uuid
  data       Bytes

  document TeacherDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("teacher_document_files")
}

// ─────────────────────────────────────────────────────────────
// Administração: empresas do grupo, contas bancárias e documentos essenciais
// ─────────────────────────────────────────────────────────────

model Company {
  id                    String    @id @default(uuid()) @db.Uuid
  legalName             String    @map("legal_name")
  tradeName             String?   @map("trade_name")
  cnpj                  String?   @unique @db.Char(14)
  stateRegistration     String?   @map("state_registration")
  municipalRegistration String?   @map("municipal_registration")
  openingDate           DateTime? @map("opening_date") @db.Date
  taxRegime             String?   @map("tax_regime")
  mainActivity          String?   @map("main_activity")
  address               String?
  email                 String?
  phone                 String?
  legalRepresentative   String?   @map("legal_representative")
  accountant            String?
  notes                 String?
  active                Boolean   @default(true)
  sortOrder             Int       @default(0) @map("sort_order")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  bankAccounts CompanyBankAccount[]
  documents    CompanyDocument[]

  @@map("companies")
}

model CompanyBankAccount {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  bank        String
  agency      String?
  account     String?
  accountType String? @map("account_type")
  pixKey      String? @map("pix_key")
  notes       String?
  sortOrder   Int     @default(0) @map("sort_order")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_bank_accounts")
}

enum CompanyDocKind {
  CONTRATO_SOCIAL
  ALTERACAO_CONTRATUAL
  CARTAO_CNPJ
  LICENCA_FUNCIONAMENTO
  ALVARA_BOMBEIROS
  PROCURACAO
  CERTIDAO
  INFORMACOES_BANCARIAS
  CONTRATO
  OUTRO
}

model CompanyDocument {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  kind         CompanyDocKind
  /// Ex.: "Procuração — escritório contábil", "CND federal".
  title        String?
  filename     String
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  sha256       String         @db.Char(64)
  validFrom    DateTime?      @map("valid_from") @db.Date
  validUntil   DateTime?      @map("valid_until") @db.Date
  notes        String?
  /// Substituído por um mais novo: fica no histórico, fora dos alertas.
  archived     Boolean        @default(false)
  uploadedById String?        @map("uploaded_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file    CompanyDocumentFile?

  @@index([companyId, kind])
  @@map("company_documents")
}

model CompanyDocumentFile {
  documentId String @id @map("document_id") @db.Uuid
  data       Bytes

  document CompanyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("company_document_files")
}

// ─────────────────────────────────────────────────────────────
// Marketing Nação (Fase 1): áreas, campanhas, eventos, tarefas (Kanban),
// calendário, sugestões da IA (sempre com aceite humano) e reunião semanal.
// Pessoas e modalidades por id (sem tocar nos modelos existentes).
// ─────────────────────────────────────────────────────────────

enum MktCampaignType {
  AQUISICAO
  RENOVACAO
  RETENCAO
  EVENTO
  INSTITUCIONAL
  ENDOMARKETING
  AWARENESS
  PARCERIA
  VENDAS
  LANCAMENTO
}

enum MktCampaignStatus {
  IDEIA
  PLANEJAMENTO
  PRODUCAO
  AGUARDANDO_APROVACAO
  PROGRAMADA
  ATIVA
  FINALIZADA
  ANALISE
}

enum MktTaskColumn {
  BACKLOG
  PROXIMAS
  SEMANA
  PRODUCAO
  APROVACAO
  PROGRAMADO
  EXECUTADO
  RESULTADOS
}

enum MktPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum MktTaskOrigin {
  MANUAL
  IA
  REUNIAO
  ANTECEDENCIA
  IMPORTACAO
}

enum MktEventStatus {
  PLANEJADO
  CONFIRMADO
  REALIZADO
  CANCELADO
}

enum MktCalendarKind {
  DATA_COMEMORATIVA
  ACAO_COMERCIAL
  PARCERIA
  ATIVACAO
  LANCAMENTO
  SAUDE
  ENDOMARKETING
  AVISO
  TEMA_DO_MES
  CONTEUDO
  OUTRO
}

enum MktSuggestionStatus {
  PENDENTE
  ACEITA
  PARCIAL
  RECUSADA
}

model MktArea {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  name          String
  color         String
  question      String?
  defaultUserId String?  @map("default_user_id") @db.Uuid
  /// Corresponsáveis padrão: entram como corresponsáveis nas tarefas novas da área.
  coOwnerIds    String[] @default([]) @map("co_owner_ids") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")

  tasks MktTask[]

  @@map("mkt_areas")
}

model MktEvent {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  location        String?
  audience        String?
  registrationUrl String?        @map("registration_url")
  modalityId      String?        @map("modality_id") @db.Uuid
  status          MktEventStatus @default(PLANEJADO)
  ownerId         String?        @map("owner_id") @db.Uuid
  notes           String?
  createdById     String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  /// Lote de importação (cronograma) que criou o registro — permite desfazer.
  importId        String?        @map("import_id") @db.Uuid

  campaigns   MktCampaign[]
  tasks       MktTask[]
  wsOverrides WsDayOverride[]

  @@index([startDate])
  @@index([importId])
  @@map("mkt_events")
}

model MktCampaign {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  type              MktCampaignType
  status            MktCampaignStatus @default(IDEIA)
  objective         String?
  audience          String?
  product           String?
  offer             String?
  message           String?
  cta               String?
  /// Chaves de canais (externos/internos) — Fase 2 ganha tabela própria com URL/UTM.
  channels          String[]          @default([])
  conversionChannel String?           @map("conversion_channel")
  conversionUrl     String?           @map("conversion_url")
  leadOwnerId       String?           @map("lead_owner_id") @db.Uuid
  measurement       String?
  goal              String?
  kpis              String?
  startDate         DateTime          @map("start_date") @db.Date
  endDate           DateTime?         @map("end_date") @db.Date
  budgetCents       Int?              @map("budget_cents")
  ownerId           String?           @map("owner_id") @db.Uuid
  participantIds    String[]          @default([]) @map("participant_ids") @db.Uuid
  modalityId        String?           @map("modality_id") @db.Uuid
  eventId           String?           @map("event_id") @db.Uuid
  /// Como funciona (modalidades, vagas, horários, regras): vai no Briefing e no comunicado à equipe.
  details           String?
  notes             String?
  createdById       String?           @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  /// Lote de importação (cronograma) que criou o registro — permite desfazer.
  importId          String?           @map("import_id") @db.Uuid

  event       MktEvent?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tasks       MktTask[]
  suggestions MktAiSuggestion[]

  @@index([startDate])
  @@index([status])
  @@index([importId])
  @@map("mkt_campaigns")
}

/// Colunas do Kanban de Marketing, editáveis em Configurações. Cada uma
/// "funciona como" uma etapa fixa (stage) — é ela que conta para prontidão e atrasos.
model MktBoardColumn {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  color     String?
  stage     MktTaskColumn
  position  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")

  tasks MktTask[]

  @@map("mkt_board_columns")
}

model MktTask {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  campaignId      String?       @map("campaign_id") @db.Uuid
  eventId         String?       @map("event_id") @db.Uuid
  areaId          String?       @map("area_id") @db.Uuid
  assigneeId      String?       @map("assignee_id") @db.Uuid
  collaboratorIds String[]      @default([]) @map("collaborator_ids") @db.Uuid
  dueDate         DateTime?     @map("due_date") @db.Date
  priority        MktPriority   @default(MEDIA)
  column          MktTaskColumn @default(BACKLOG)
  /// Coluna do quadro (editável). `column` guarda a etapa que ela representa.
  columnId        String?       @map("column_id") @db.Uuid
  position        Float         @default(1000)
  tags            String[]      @default([])
  origin          MktTaskOrigin @default(MANUAL)
  /// Marco de antecedência que originou a tarefa (ex.: "D-7").
  milestone       String?
  /// Origem externa (ex.: "trello:<id do card>") — evita importar o mesmo card duas vezes.
  externalRef     String?       @unique @map("external_ref")
  doneAt          DateTime?     @map("done_at")
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  campaign    MktCampaign?        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  event       MktEvent?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  area        MktArea?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  boardColumn MktBoardColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull)
  checklist   MktTaskCheckItem[]
  links       MktTaskLink[]
  attachments MktTaskAttachment[]
  dependsOn   MktTaskDependency[] @relation("TaskDependsOn")
  blocking    MktTaskDependency[] @relation("TaskBlocks")

  @@index([column, position])
  @@index([columnId])
  @@index([campaignId])
  @@index([dueDate])
  @@map("mkt_tasks")
}

model MktTaskCheckItem {
  id       String  @id @default(uuid()) @db.Uuid
  taskId   String  @map("task_id") @db.Uuid
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  task MktTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("mkt_task_check_items")
}

model MktTaskLink {
  id     String  @id @default(uuid()) @db.Uuid
  taskId String  @map("task_id") @db.Uuid
  url    String
  label  String?

  task MktTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("mkt_task_links")
}

/// Imagem anexada ao cartão do Kanban (arquivo no bucket privado; capa = aparece no cartão).
model MktTaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  path        String
  fileName    String   @map("file_name")
  mime        String
  sizeBytes   Int      @map("size_bytes")
  isCover     Boolean  @default(false) @map("is_cover")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  task MktTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("mkt_task_attachments")
}

model MktTaskDependency {
  taskId      String @map("task_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  task      MktTask @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn MktTask @relation("TaskBlocks", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@map("mkt_task_dependencies")
}

model MktComment {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("mkt_comments")
}

model MktCalendarItem {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  kind        MktCalendarKind
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  description String?
  modalityId  String?         @map("modality_id") @db.Uuid
  ownerId     String?         @map("owner_id") @db.Uuid
  audience    String?
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  /// Lote de importação (cronograma) que criou o registro — permite desfazer.
  importId    String?         @map("import_id") @db.Uuid

  @@index([startDate])
  @@index([importId])
  @@map("mkt_calendar_items")
}

model MktAiSuggestion {
  id            String              @id @default(uuid()) @db.Uuid
  /// TAREFAS_CAMPANHA | ATA_REUNIAO | RECOMENDACOES
  kind          String
  campaignId    String?             @map("campaign_id") @db.Uuid
  meetingId     String?             @map("meeting_id") @db.Uuid
  payload       Json
  status        MktSuggestionStatus @default(PENDENTE)
  promptVersion String              @map("prompt_version")
  model         String?
  createdById   String?             @map("created_by") @db.Uuid
  decidedById   String?             @map("decided_by") @db.Uuid
  decidedAt     DateTime?           @map("decided_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  campaign MktCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  meeting  MktMeeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([kind, status])
  @@map("mkt_ai_suggestions")
}

model MktMeeting {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  agenda      Json
  notes       String?
  minutes     String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  suggestions MktAiSuggestion[]

  @@index([date])
  @@map("mkt_meetings")
}

/// Importação de cronograma (documento → eventos, campanhas e datas). Desfazível.
model MktImport {
  id          String    @id @default(uuid()) @db.Uuid
  source      String
  /// Quantos registros de cada tipo foram criados.
  counts      Json
  undoneAt    DateTime? @map("undone_at")
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("mkt_imports")
}

/// Memória da Nação: aprendizados de marketing (revisados por humano) que a IA usa como contexto.
model MktKnowledge {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  /// Arquivo/documento de origem (ou "manual").
  source      String?
  content     String
  active      Boolean  @default(true)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("mkt_knowledge")
}

/// Mensagem de WhatsApp enviada pelo sistema (Z-API). O texto de mensagens com senha não é guardado.
model WaMessage {
  id          String   @id @default(uuid()) @db.Uuid
  /// TESTE, ACESSO, ESCALA, CONDOMINIO, TREINO, LIVRE…
  kind        String
  /// Destino mascarado (ex.: "(61) 9••••-2806" ou "grupo").
  toMasked    String   @map("to_masked")
  /// Prévia do texto (vazia quando a mensagem tem senha).
  preview     String?
  hasFile     Boolean  @default(false) @map("has_file")
  /// SENT, FAILED, SIMULATED.
  status      String
  /// Redirecionada para o número de teste.
  testMode    Boolean  @default(false) @map("test_mode")
  providerId  String?  @map("provider_id")
  error       String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("wa_messages")
}

// ── Gestão de Processos ─────────────────────────────────────
// Rotinas e checklists ficam no Nação Task; aqui é o acompanhamento:
// setores, líderes e as demandas que a diretoria cobra de cada um.

enum ProcDemandStatus {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDA
  CANCELADA
}

enum ProcPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// Setor da Nação com o líder responsável.
model ProcSector {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  /// Usuário líder do setor (vê e atualiza as demandas do setor).
  leaderId    String?  @map("leader_id") @db.Uuid
  /// Link direto das rotinas deste setor no Nação Task (opcional).
  taskUrl     String?  @map("task_url")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  demands   ProcDemand[]
  wsSectors WsSector[]

  @@map("proc_sectors")
}

/// Demanda acompanhada pela gestão (o que se cobra do líder; não é rotina).
model ProcDemand {
  id          String           @id @default(uuid()) @db.Uuid
  sectorId    String           @map("sector_id") @db.Uuid
  title       String
  description String?
  /// Responsável pela entrega (padrão: o líder do setor).
  ownerId     String?          @map("owner_id") @db.Uuid
  requesterId String?          @map("requester_id") @db.Uuid
  dueDate     DateTime?        @map("due_date") @db.Date
  priority    ProcPriority     @default(MEDIA)
  status      ProcDemandStatus @default(ABERTA)
  /// DIRETORIA, REUNIAO, LIDER, ALERTA.
  origin      String           @default("DIRETORIA")
  doneAt      DateTime?        @map("done_at")
  /// Semana em que a demanda é "foco" (compromisso da reunião semanal), ex.: 2026-W42.
  focusWeek   String?          @map("focus_week")
  /// Impedimento atual (daily); vazio = sem impedimento.
  blocker     String?
  /// Reunião em que a demanda foi aberta (origem REUNIAO).
  meetingId   String?          @map("meeting_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sector   ProcSector    @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  comments ProcComment[]

  @@index([sectorId, status])
  @@index([ownerId, status])
  @@index([focusWeek])
  @@map("proc_demands")
}

/// Reunião de líderes: semanal (placar, atrasadas, foco da semana), daily (15 min)
/// ou ATA (registro de reunião online/presencial: participantes, pauta e decisões).
model ProcMeeting {
  id             String    @id @default(uuid()) @db.Uuid
  /// SEMANAL, DIARIA ou ATA
  kind           String
  /// Ata: título/assunto da reunião.
  title          String?
  /// Ata: ONLINE ou PRESENCIAL.
  mode           String?
  /// Ata: usuários que participaram.
  participantIds String[]  @default([]) @map("participant_ids") @db.Uuid
  /// Ata: convidados de fora do sistema (texto livre).
  guests         String?
  /// Ata: resumo da pauta / o que foi discutido.
  agenda         String?
  /// Ata: link da gravação ou do documento da reunião.
  link           String?
  date           DateTime  @db.Date
  /// Semana ISO (ex.: 2026-W42) — o foco combinado vale para ela.
  week           String
  notes          String?
  /// ABERTA ou ENCERRADA
  status         String    @default("ABERTA")
  /// Números no encerramento (concluídas, atrasadas, foco…).
  summary        Json?
  createdById    String?   @map("created_by") @db.Uuid
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([date])
  @@map("proc_meetings")
}

model ProcComment {
  id        String   @id @default(uuid()) @db.Uuid
  demandId  String   @map("demand_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  demand ProcDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId, createdAt])
  @@map("proc_comments")
}

/// Automação de WhatsApp: quando roda, para quem vai e o modelo do texto. Editável no sistema.
model WaAutomation {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  active          Boolean   @default(true)
  /// DIARIA, SEMANAL, MENSAL
  frequency       String
  /// Dias da semana (1 = segunda … 7 = domingo) na frequência semanal.
  weekdays        Int[]     @default([])
  /// Dia do mês (1–28) na frequência mensal.
  monthDay        Int?      @map("month_day")
  /// Público (ver AUDIENCES): LIDERES_PENDENCIAS, ESCALADOS_FDS, PROFESSORES_GRADE…
  audience        String
  /// Filtro do público: { modalityId } | { roleKey } | { numbers: [] }.
  filter          Json?
  /// Texto com variáveis: {primeiro_nome}, {demandas}, {escala}, {grade}…
  template        String
  /// Pede resposta: "ok" confirma, outro texto vira pedido de ajuste.
  askConfirmation Boolean   @default(false) @map("ask_confirmation")
  /// Período já enviado (dia, semana ISO ou mês): impede envio duplicado.
  lastPeriod      String?   @map("last_period")
  lastRunAt       DateTime? @map("last_run_at")
  lastResult      Json?     @map("last_result")
  createdById     String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("wa_automations")
}

/// Mensagem recebida no WhatsApp da Nação (webhook da Z-API "Ao receber").
model WaInbound {
  id         String   @id @default(uuid()) @db.Uuid
  /// ID da mensagem na Z-API (evita processar duas vezes).
  messageId  String   @unique @map("message_id")
  /// DDD + 8 últimos dígitos (para casar com professor/usuário).
  phoneKey   String   @map("phone_key")
  toMasked   String   @map("to_masked")
  senderName String?  @map("sender_name")
  text       String?
  teacherId  String?  @map("teacher_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  /// O que o sistema fez com ela: CONFIRMOU_GRADE, AJUSTE_GRADE ou nada.
  handled    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([phoneKey])
  @@map("wa_inbound")
}

/// Pedido de confirmação enviado pelo WhatsApp (ex.: grade do mês) e a resposta.
model WaConfirmation {
  id           String    @id @default(uuid()) @db.Uuid
  /// Automação que pediu a confirmação (id) — ou "GRADE" nos registros antigos.
  kind         String
  /// Ex.: 2026-11, 2026-W43, 2026-10-24
  period       String
  /// Quem: "t:<professor>", "u:<usuário>" ou "n:<número>".
  recipientKey String    @map("recipient_key")
  teacherId    String?   @map("teacher_id") @db.Uuid
  name         String
  /// O que está sendo confirmado (ex.: "Grade mensal · novembro de 2026").
  subject      String?
  /// Para onde foi (DDD + 8 últimos dígitos) — em modo teste, o número de teste.
  phoneKey     String    @map("phone_key")
  /// PENDENTE, CONFIRMADO, AJUSTE
  status       String    @default("PENDENTE")
  reply        String?
  sentAt       DateTime  @default(now()) @map("sent_at")
  repliedAt    DateTime? @map("replied_at")

  @@unique([kind, period, recipientKey])
  @@index([phoneKey, status])
  @@map("wa_confirmation_requests")
}

// ── Marketing: leads e links rastreáveis ────────────────────

/// Lead (interessado): chega pelo site (formulário Wix), WhatsApp, link de campanha ou cadastro manual.
model MktLead {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  phone        String?
  email        String?
  /// Modalidade de interesse (texto livre do formulário ou escolhida).
  interest     String?
  modalityId   String?   @map("modality_id") @db.Uuid
  /// SITE, WHATSAPP, INSTAGRAM, INDICACAO, EVENTO, PRESENCIAL, LINK, OUTRO
  source       String    @default("OUTRO")
  /// NOVO, CONTATO, EXPERIMENTAL, NEGOCIACAO, MATRICULADO, PERDIDO
  stage        String    @default("NOVO")
  ownerId      String?   @map("owner_id") @db.Uuid
  campaignId   String?   @map("campaign_id") @db.Uuid
  linkId       String?   @map("link_id") @db.Uuid
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")
  notes        String?
  lostReason   String?   @map("lost_reason")
  /// Dados brutos do formulário (para conferir), sem segredo.
  raw          Json?
  /// Chave para não duplicar o mesmo envio do formulário.
  externalRef  String?   @unique @map("external_ref")
  nextActionAt DateTime? @map("next_action_at") @db.Date
  convertedAt  DateTime? @map("converted_at")
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

