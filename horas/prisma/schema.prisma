/// Link rastreável: /l/<slug> redireciona para o destino com UTM e conta os cliques.
model MktLink {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  destination String
  /// Canal: INSTAGRAM, WHATSAPP, GOOGLE, META_ADS, EMAIL, QRCODE, SITE, OUTRO
  channel     String    @default("OUTRO")
  utmSource   String?   @map("utm_source")
  utmMedium   String?   @map("utm_medium")
  utmCampaign String?   @map("utm_campaign")
  utmContent  String?   @map("utm_content")
  campaignId  String?   @map("campaign_id") @db.Uuid
  active      Boolean   @default(true)
  clicks      Int       @default(0)
  lastClickAt DateTime? @map("last_click_at")
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("mkt_links")
}

/// Cliques por dia (para o gráfico de Performance), sem dado pessoal.
model MktLinkClickDay {
  linkId String   @map("link_id") @db.Uuid
  day    DateTime @db.Date
  clicks Int      @default(0)

  @@id([linkId, day])
  @@map("mkt_link_click_days")
}

/// Criativo da Biblioteca (arquivo no Supabase Storage, bucket privado "marketing").
model MktAsset {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  /// ARTE, VIDEO, FOTO, LOGO, TEMPLATE, DOCUMENTO, OUTRO
  kind         String    @default("ARTE")
  /// RASCUNHO, EM_APROVACAO, AJUSTES, APROVADO, ARQUIVADO
  status       String    @default("RASCUNHO")
  campaignId   String?   @map("campaign_id") @db.Uuid
  eventId      String?   @map("event_id") @db.Uuid
  tags         String[]  @default([])
  notes        String?
  /// Caminho no bucket (nunca a URL pública: leitura só por URL assinada).
  path         String    @unique
  fileName     String    @map("file_name")
  mime         String
  sizeBytes    Int       @map("size_bytes")
  reviewNote   String?   @map("review_note")
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  uploadedById String?   @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([campaignId])
  @@map("mkt_assets")
}

/// Gasto em anúncio num período (lançado à mão ou, no futuro, vindo da API Meta/Google).
model MktAdSpend {
  id            String   @id @default(uuid()) @db.Uuid
  /// META, GOOGLE, TIKTOK, OUTRO
  platform      String
  campaignId    String?  @map("campaign_id") @db.Uuid
  /// Nome da campanha/conjunto na plataforma (para conferir com o Gerenciador).
  adName        String?  @map("ad_name")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  spendCents    Int      @map("spend_cents")
  impressions   Int?
  clicks        Int?
  /// Leads que a plataforma diz ter gerado (o painel usa os leads reais do funil).
  platformLeads Int?     @map("platform_leads")
  notes         String?
  /// MANUAL ou API
  origin        String   @default("MANUAL")
  /// Chave da linha importada pela API (evita duplicar).
  externalRef   String?  @unique @map("external_ref")
  createdById   String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([periodStart, periodEnd])
  @@index([campaignId])
  @@map("mkt_ad_spends")
}

/// Comunicado interno: vai por WhatsApp para um público e aparece no mural do app.
model MktNotice {
  id              String    @id @default(uuid()) @db.Uuid
  /// AVISO, CAMPANHA, EVENTO, ROTINA, URGENTE
  kind            String    @default("AVISO")
  title           String
  body            String
  /// TODOS, LIDERES, PROFESSORES, PERFIL, NUMEROS
  audience        String    @default("TODOS")
  filter          Json?
  campaignId      String?   @map("campaign_id") @db.Uuid
  sendWhatsApp    Boolean   @default(true) @map("send_whatsapp")
  askConfirmation Boolean   @default(false) @map("ask_confirmation")
  pinned          Boolean   @default(false)
  showUntil       DateTime? @map("show_until") @db.Date
  /// RASCUNHO ou PUBLICADO
  status          String    @default("RASCUNHO")
  publishedAt     DateTime? @map("published_at")
  publishedById   String?   @map("published_by") @db.Uuid
  /// Resultado do envio (total, enviados, falhas, sem telefone).
  sendResult      Json?     @map("send_result")
  createdById     String?   @map("created_by") @db.Uuid
