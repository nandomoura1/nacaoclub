/// "Li" no mural do app.
model MktNoticeRead {
  noticeId String   @map("notice_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  notice MktNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@map("mkt_notice_reads")
}

// ─────────────────────────────────────────────────────────────
// Universidade Nação: materiais de capacitação e trilhas
// ─────────────────────────────────────────────────────────────

/// Material de capacitação: link (Drive, YouTube, Canva, Spotify…) ou arquivo no bucket privado.
model EduMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  /// ESSENCIAL, TECNICA, GESTAO
  area        String
  /// Setor ou modalidade (Academia, Recepção, Liderança…), texto livre.
  category    String?
  /// LINK, PDF, VIDEO, AUDIO, EBOOK, APRESENTACAO, DOCUMENTO, OUTRO
  format      String
  url         String?
  /// Arquivo no bucket (leitura só por URL assinada).
  path        String?  @unique
  fileName    String?  @map("file_name")
  mime        String?
  sizeBytes   Int?     @map("size_bytes")
  /// TODOS, LIDERES, PROFESSORES, PERFIL
  audience    String   @default("TODOS")
  roleKey     String?  @map("role_key")
  required    Boolean  @default(false)
  version     String?
  durationMin Int?     @map("duration_min")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  completions EduCompletion[]
  trackItems  EduTrackItem[]

  @@index([area, active])
  @@map("edu_materials")
}

/// "Concluí" de um colaborador num material.
model EduCompletion {
  materialId  String   @map("material_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  material EduMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([materialId, userId])
  @@index([userId])
  @@map("edu_completions")
}

/// Trilha de capacitação (ex.: Onboarding do Colaborador Nação): materiais em sequência.
model EduTrack {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// TODOS, LIDERES, PROFESSORES, PERFIL
  audience    String   @default("TODOS")
  roleKey     String?  @map("role_key")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items EduTrackItem[]

  @@map("edu_tracks")
}

model EduTrackItem {
  trackId    String @map("track_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  position   Int    @default(0)

  track    EduTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  material EduMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([trackId, materialId])
  @@index([trackId, position])
  @@map("edu_track_items")
}

// ─────────────────────────────────────────────────────────────
// Escalas de Trabalho 5x2 (organizador mensal por setor)
// ─────────────────────────────────────────────────────────────

/// CLT, FUNAP, MEI ou freelancer: cada vínculo tem regras próprias (5x2 não vale para todos).
enum WsBond {
  CLT
  FUNAP
  MEI
  FREELANCER
}

/// FIXO = entra na escala nos dias dele; COBERTURA = só cobre buracos nos dias disponíveis (MEI/freelancer).
enum WsMode {
  FIXO
  COBERTURA
}

enum WsScheduleStatus {
  RASCUNHO
  APROVADA
  PUBLICADA
}

/// Setor que tem escala mensal (Recepção, Limpeza, Lanchonete, Cozinha…).
model WsSector {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  /// Setor da Gestão de Processos (o líder dele monta a escala).
  procSectorId   String?  @map("proc_sector_id") @db.Uuid
  /// Horário habitual: { "1": [[420, 1320]], …, "7": [], "F": [[480, 840]] } (minutos). Sem a chave = usa o da Nação; [] = fechado.
  hours          Json     @default("{}")
  /// Segunda-feira de uma semana "A": a fase A/B do revezamento segue daqui, sem reiniciar no dia 1º.
  cycleRef       DateTime @map("cycle_ref") @db.Date
  /// No feriado o setor funciona como SABADO ou DOMINGO (equipe e postos desse dia, no horário de feriado). Vazio = horário de feriado para todos.
  holidayMode    String?  @map("holiday_mode")
  /// true = todo feriado aparece para o gestor confirmar, mesmo com o horário já definido.
  holidayConfirm Boolean  @default(false) @map("holiday_confirm")
  /// Rodízio de feriados: quem trabalha no feriado é quem trabalhou menos feriados (histórico dos meses), com os turnos de sábado/domingo.
  holidayRotate  Boolean  @default(false) @map("holiday_rotate")
  /// Quantas pessoas trabalham no feriado (ex.: Recepção = 1). Vazio = a equipe do dia.
  holidayStaff   Int?     @map("holiday_staff")
  notes          String?
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  procSector ProcSector?     @relation(fields: [procSectorId], references: [id], onDelete: SetNull)
  posts      WsPost[]
  members    WsMember[]
  rules      WsRule[]
  overrides  WsDayOverride[]
  schedules  WsSchedule[]

  @@map("ws_sectors")
}

/// Posto/turno que precisa de gente (Abertura 06:00–14:00, Fechamento, Almoço…).
model WsPost {
  id           String   @id @default(uuid()) @db.Uuid
  sectorId     String   @map("sector_id") @db.Uuid
  name         String
  /// ABERTURA, FECHAMENTO, ALMOCO ou vazio.
  kind         String?
  startMin     Int      @map("start_min")
  endMin       Int      @map("end_min")
  /// 1 = segunda … 7 = domingo; 8 = feriado.
  weekdays     Int[]
  minPeople    Int      @default(1) @map("min_people")
  /// Só quem tem esta função (principal ou alternativa) cobre o posto.
  functionName String?  @map("function_name")
  mandatory    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  sector WsSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([sectorId])
  @@map("ws_posts")
}

/// Colaborador na equipe do setor (o cadastro da pessoa é o de sempre: teachers).
model WsMember {
  id            String   @id @default(uuid()) @db.Uuid
  sectorId      String   @map("sector_id") @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  functionName  String?  @map("function_name")
  altFunctions  String[] @map("alt_functions")
  bond          WsBond   @default(CLT)
  mode          WsMode   @default(FIXO)
  /// { "base": [entrada, saída, intervalo], "6": […], "7": […], "F": […] } em minutos. Sem "base" = horário pendente.
  hours         Json     @default("{}")
  /// Carga semanal de referência (minutos): 2400 = 40h.
  weeklyMin     Int      @default(2400) @map("weekly_min")
  fixedOff      Int[]    @map("fixed_off")
  /// Dias em que pode trabalhar (vazio = todos). Para COBERTURA: só nesses dias.
  availableDays Int[]    @map("available_days")
  saturday      Boolean  @default(true)
  sunday        Boolean  @default(true)
  holiday       Boolean  @default(true)
  /// false = fica fora da geração automática (ex.: líder sem horário definido).
  autoSchedule  Boolean  @default(true) @map("auto_schedule")
  notes         String?
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sector  WsSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  teacher Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  cells   WsCell[]

  @@unique([sectorId, teacherId])
  @@map("ws_members")
}

/// Pré-requisito do setor. kind + params (ver src/domain/escalas/rules.ts).
model WsRule {
  id        String   @id @default(uuid()) @db.Uuid
  sectorId  String   @map("sector_id") @db.Uuid
  kind      String
  label     String
  params    Json     @default("{}")
  /// true = obrigatória (sem ela a escala tem conflito); false = preferencial.
  mandatory Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sector WsSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([sectorId])
  @@map("ws_rules")
}

/// Funcionamento especial numa data: da Nação (sem setor) ou de um setor; e reforço de evento.
model WsDayOverride {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  sectorId    String?  @map("sector_id") @db.Uuid
  closed      Boolean  @default(false)
  /// [[início, fim]] em minutos; vazio = mantém o horário (só reforço/observação).
  hours       Json?
  reason      String
  eventId     String?  @map("event_id") @db.Uuid
  /// Pessoas a mais pedidas pelo evento (sugestão de reforço; não muda a escala sozinho).
  extraPeople Int      @default(0) @map("extra_people")
  /// Gestor confirmou o funcionamento nesta data (some o aviso "confirme" do feriado).
  confirmed   Boolean  @default(false)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  sector WsSector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  event  MktEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("ws_day_overrides")
}

/// Parâmetros de jornada por vínculo, com vigência — validados pelo Departamento Pessoal.
model WsLegalParam {
  id                  String    @id @default(uuid()) @db.Uuid
  bond                WsBond
  validFrom           DateTime  @map("valid_from") @db.Date
  maxDailyMin         Int?      @map("max_daily_min")
  maxDailyExtraMin    Int?      @map("max_daily_extra_min")
  maxWeeklyMin        Int?      @map("max_weekly_min")
  minRestBetweenMin   Int?      @map("min_rest_between_min")
  maxConsecutiveDays  Int?      @map("max_consecutive_days")
  /// Folga no domingo pelo menos 1 vez a cada N semanas (vazio = não verifica).
  sundayOffEveryWeeks Int?      @map("sunday_off_every_weeks")
  /// Jornada acima disto pede intervalo de `breakLongMin`.
  breakLongOverMin    Int?      @map("break_long_over_min")
  breakLongMin        Int?      @map("break_long_min")
  breakShortOverMin   Int?      @map("break_short_over_min")
  breakShortMin       Int?      @map("break_short_min")
  /// Intervalo máximo por dia (ex.: FUNAP até 2h). Vazio = não verifica.
  maxBreakMin         Int?      @map("max_break_min")
  notes               String?
  /// Vazio = ainda não conferido pelo DP: a escala mostra a pendência.
  validatedAt         DateTime? @map("validated_at")
  validatedBy         String?   @map("validated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([bond, validFrom])
  @@map("ws_legal_params")
}

/// Escala de um setor num mês (rascunho → aprovada → publicada).
model WsSchedule {
  id          String           @id @default(uuid()) @db.Uuid
  sectorId    String           @map("sector_id") @db.Uuid
  year        Int
  month       Int
  status      WsScheduleStatus @default(RASCUNHO)
  /// Resultado da última análise (indicadores, alertas, classificação).
  analysis    Json             @default("{}")
  generatedAt DateTime?        @map("generated_at")
  approvedAt  DateTime?        @map("approved_at")
  approvedBy  String?          @map("approved_by") @db.Uuid
  publishedAt DateTime?        @map("published_at")
  publishedBy String?          @map("published_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sector WsSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  cells  WsCell[]

  @@unique([sectorId, year, month])
  @@map("ws_schedules")
}

/// Um dia de um colaborador na escala.
model WsCell {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  date       DateTime @db.Date
  /// TRABALHO, FOLGA, FECHADO, FERIAS, ATESTADO, FALTA, AFASTAMENTO, INDISPONIVEL
  kind       String
  startMin   Int?     @map("start_min")
  endMin     Int?     @map("end_min")
  breakMin   Int?     @map("break_min")
  note       String?
  /// Editado à mão (a geração respeita? não: gerar de novo só no rascunho e refaz tudo).
  manual     Boolean  @default(false)

  schedule WsSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member   WsMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, memberId, date])
  @@index([memberId, date])
  @@map("ws_cells")
}
