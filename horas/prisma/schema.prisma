// NAÇÃO | GESTÃO DE HORAS — modelo de dados.
// Documentação: docs/02-banco-de-dados.md
//
// Convenções: UUID, snake_case no banco, tempo em MINUTOS inteiros,
// vigências [valid_from, valid_to] com valid_to nulo = em aberto.
// O que o Prisma não expressa (triggers append-only, exclusion
// constraints) vive em SQL puro dentro das migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Configuração
// ─────────────────────────────────────────────────────────────

/// Linha única (id = 1). O dia de corte da competência mora aqui:
/// 26 → competência "Setembro" = 26/08 a 25/09.
model AppSettings {
  id             Int      @id @default(1)
  periodStartDay Int      @default(26) @map("period_start_day")
  timezone       String   @default("America/Sao_Paulo")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────
// Identidade e acesso
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdById        String?   @map("created_by") @db.Uuid

  sessions   Session[]
  roles      UserRole[]
  areaScopes UserAreaScope[]
  auditLogs  AuditLog[]

  @@map("users")
}

/// Sessão opaca: o cookie leva um token aleatório; o banco guarda só o HMAC.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Papéis são dados: o admin pode criar "Supervisor Kids" combinando permissões.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo fixo, sincronizado a partir de src/server/auth/permissions.ts.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Área de coordenação: Nação Fit, CrossFit, Aulas Coletivas, Futevôlei…
/// O escopo do coordenador é definido por área, não por pessoa.
model CoordinationArea {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  color     String    @default("#0169E9")
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userScopes UserAreaScope[]

  @@map("coordination_areas")
}

model UserAreaScope {
  userId         String  @map("user_id") @db.Uuid
  areaId         String  @map("area_id") @db.Uuid
  canViewFinance Boolean @default(false) @map("can_view_finance")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area CoordinationArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@index([areaId])
  @@map("user_area_scopes")
}

// ─────────────────────────────────────────────────────────────
// Auditoria — append-only (trigger no banco bloqueia UPDATE/DELETE)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @default(now())
  actorId    String?  @map("actor_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  /// Frase em português para a tela de histórico.
  summary    String

  /// Restrict: usuário com histórico não é apagado, é desativado.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@map("audit_logs")
}
